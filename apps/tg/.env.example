# The tg store — this app's own database on the shared Postgres server.
DATABASE_URL=postgres://bot:bot@localhost:5432/tg

# Source database for the one-shot v1 import (`npm run import:v1`).
# Point at a COPY of the v1 database during rehearsal — never production.
V1_DATABASE_URL=postgres://bot:bot@localhost:5432/bot

# Redis (bus + inbound queue) — the compose `redis` service in dev.
# REDIS_URL=redis://localhost:6379
