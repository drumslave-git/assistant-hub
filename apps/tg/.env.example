# The tg app is stateless: no database. Everything else it needs (bot
# tokens, owner identity) comes from the core at registration.

# Redis (bus + inbound queue) — the compose `redis` service in dev.
REDIS_URL=redis://localhost:6379

# This service's HTTP surface (health, sends, menus, MCP). The token must
# match the core's INTERNAL_API_TOKEN.
# PORT=3210
INTERNAL_API_TOKEN=change-me

# The core's internal API (registration, desired state, forwarded updates).
# CORE_API_URL=http://localhost:3200

# The base URL this service announces at registration — what the CORE uses
# to reach it. Defaults to http://localhost:<PORT>; set it when the core
# cannot reach this service on localhost (e.g. compose: http://tg:3210).
# SELF_URL=http://localhost:3210
