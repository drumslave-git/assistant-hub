{
  "name": "@assistant-hub/tg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram transport: stateless pollers that register with the core, forward every update as transport events, perform sends, and host the platform's MCP tools.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@assistant-hub/bus": "*",
    "@assistant-hub/contracts": "*",
    "@assistant-hub/media": "*",
    "@assistant-hub/service": "*",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/types": "^3.28.0",
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.2.0",
    "grammy": "^1.44.0",
    "hono": "^4.7.0",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
