# The chat store — this app's own database on the shared Postgres server.
DATABASE_URL=postgres://bot:bot@localhost:5432/chat

# The cross-app bus + inbound queue (shared with the core and the other
# source apps).
REDIS_URL=redis://localhost:6379

# The shared secret the core presents on this app's /internal/* surface.
# Must match the core's INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=change-me

# The port this service listens on (the core reaches it at CHAT_API_URL).
PORT=3220
