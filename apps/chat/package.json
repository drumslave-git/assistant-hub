  },
  "dependencies": {
    "@assistant-hub/contracts": "*",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
