{
  "name": "@assistant-hub/chat",
  "version": "0.0.0",
  "private": true,
  "description": "Web-chat source app. Phase 1 ships its store (schema + migrations); the runtime (threads backend, inbound events, MCP server) and the dashboard ui subpackage arrive with Phase 4.",
