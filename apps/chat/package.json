{
  "name": "@assistant-hub/chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web-chat source app: its own store (users, threads, messages, media), the operator/internal API, inbound events and reply delivery. Its dashboard UI ships as the apps/chat/ui subpackage, composed into the core's build.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@assistant-hub/bus": "*",
    "@assistant-hub/contracts": "*",
    "@assistant-hub/db": "*",
    "@assistant-hub/service": "*",
    "@hono/node-server": "^1.14.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^12.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
