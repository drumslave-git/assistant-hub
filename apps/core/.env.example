# assistant-hub environment
#
# Runtime configuration (LLM connection, model, prompts, feature settings)
# lives in DB-backed Settings edited via the dashboard — not in env vars.
# Env is bootstrap-only. Every variable also accepts a `<NAME>_FILE` variant
# pointing at a file whose contents are used instead (Docker secrets), e.g.
# DATABASE_URL_FILE=/run/secrets/database_url.

# --- Persistence (required bootstrap) ---
# Postgres (with pgvector) connection string — THE database (one schema,
# one migration chain under store/ since the Phase 10 cutover).
# For local (non-Docker) dev, point this at your own Postgres. Under
# `docker compose`, DATABASE_URL is built from the POSTGRES_* vars below and
# targets the bundled `db` service, so you can leave this unset there.
DATABASE_URL=postgres://bot:bot@localhost:5432/core

# Redis (bus + inbound queue) — the compose `redis` service in dev.
# REDIS_URL=redis://localhost:6379
# The shared secret every transport presents to the core and the core to it.
# Must match the value in each transport's own environment. Transport base
# URLs are announced at registration — not env.
# INTERNAL_API_TOKEN=change-me

# --- Docker compose ---
# Bundled Postgres credentials + published app port.
# POSTGRES_USER=bot
# POSTGRES_PASSWORD=bot
# POSTGRES_DB=bot
# POSTGRES_PORT=5432
# PORT=3200

# --- Runtime ---
# On-disk state is NOT configurable: the database, the trace logs and the
# browser-agent downloads always live under ./data (data/pg, data/traces,
# data/downloads), locally and in the container alike.
# IANA timezone for scheduled work (default UTC).
# TZ=Europe/Berlin
