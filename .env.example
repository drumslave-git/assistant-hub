# llm-tg-bot-nextjs environment
#
# Runtime configuration (LLM connection, model, prompts, feature settings)
# lives in DB-backed Settings edited via the dashboard — not in env vars.
# Env is bootstrap-only. Every variable also accepts a `<NAME>_FILE` variant
# pointing at a file whose contents are used instead (Docker secrets), e.g.
# DATABASE_URL_FILE=/run/secrets/database_url.

# --- Persistence (required bootstrap) ---
# Postgres (with pgvector) connection string.
# For local (non-Docker) dev, point this at your own Postgres. Under
# `docker compose`, DATABASE_URL is built from the POSTGRES_* vars below and
# targets the bundled `db` service, so you can leave this unset there.
DATABASE_URL=postgres://bot:bot@localhost:5432/bot

# --- Docker compose ---
# Bundled Postgres credentials + published app port.
# POSTGRES_USER=bot
# POSTGRES_PASSWORD=bot
# POSTGRES_DB=bot
# POSTGRES_PORT=5432
# PORT=3200
# Host directory Postgres persists into (bind-mounted).
# PG_DATA_DIR=./data/pg
# Host directory trace/debug logs persist into (bind-mounted). Inside the
# container the app writes to /app/data/traces; this maps the host side.
# TRACES_DATA_DIR=./data/traces
# Host directory browser-agent downloads persist into (bind-mounted). Inside the
# container the app writes to /app/data/downloads; this maps the host side.
# DOWNLOADS_DATA_DIR=./data/downloads

# --- Runtime ---
# Directory the file-backed trace/debug store writes monthly logs into.
# Bootstrap plumbing (a filesystem mount), not runtime product config. Under
# `docker compose` this is set to /app/data/traces; for local dev leave it unset
# to default to ./data/traces.
# TRACES_DIR=./data/traces
# Directory the browser agent streams downloaded files into. Same kind of
# bootstrap plumbing as TRACES_DIR: under `docker compose` this is set to
# /app/data/downloads; for local dev leave it unset to default to ./downloads.
# DOWNLOADS_DIR=./downloads
# IANA timezone for scheduled work (default UTC).
# TZ=Europe/Berlin
